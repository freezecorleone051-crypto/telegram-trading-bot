# Copie ce fichier en .env puis remplis-le :
#   cp .env.example .env

# ================= TELEGRAM (obligatoire) =================
# 1) Token du bot : parle à @BotFather sur Telegram -> /newbot -> copie ici
BOT_TOKEN=remplace_par_le_token_de_BotFather

# 2) Ton ID Telegram numérique : envoie un message à @userinfobot pour l'obtenir
ADMIN_ID=123456789

# 3) (Optionnel) autres IDs autorisés, séparés par des virgules
# ALLOWED_IDS=

# ================= DÉCISION DE SIGNAL =================
# Confiance minimale (%) pour annoncer ACHAT/VENTE (sinon ATTENDRE)
SIGNAL_MIN_CONFIDENCE=62
# Points minimum (sur 12 max par côté) et écart de points minimum
SIGNAL_MIN_POINTS=5
SIGNAL_MIN_MARGIN=2

# ================= SCAN AUTOMATIQUE =================
SCAN_INTERVAL_MIN=5
# Après un signal, ne pas renvoyer le même pendant X minutes
COOLDOWN_MIN=15
# Démarrer le scan dès le lancement (utile pour les sessions GitHub Actions)
AUTO_SCAN=0
# Watchlist initiale (format marche:actif:timeframe, virgules entre les items)
WATCHLIST=crypto:BTC/USDT:5m,forex:EUR/USD:5m,otc:BTC/USD OTC:5m

# ================= GESTION DU RISQUE =================
# Balance fictive pour le calcul de taille de position (0 = ne rien afficher)
BALANCE=0
# % du capital risqué par trade
RISK_PCT=1.0
# TP = entrée + TP_ATR x ATR ; SL = entrée - SL_ATR x ATR
TP_ATR=1.5
SL_ATR=1.0

# ================= DIVERS =================
# Fuseau horaire affiché sur les graphiques et messages
TZ_NAME=Africa/Lubumbashi
# Nombre de bougies dessinées sur l'image
NB_CANDLES_CHART=80
# Cache des cours en secondes (évite de marteler les API)
FEED_CACHE_TTL=25
